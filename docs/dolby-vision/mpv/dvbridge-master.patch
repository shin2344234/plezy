+        MP_WARN(vo, "No usable Dolby Vision metadata at %f, "
+                "keeping the previous packets.\n", mpi->pts);
+        p->dv_warned_meta = true;
+    }
+    if (ok && p->dv.cm4_omitted && !p->dv_warned_cm4) {
+        MP_WARN(vo, "Leaving out %u CM v4.0 metadata blocks per frame.\n",
+                p->dv.cm4_omitted);
+        p->dv_warned_cm4 = true;
+    }
+    if (ok) {
+        MP_TRACE(vo, "DV packets: %u, payload %u bytes, id %u\n",
+                 p->dv.count, p->dv.size, p->dv.id);
+    }
+}
