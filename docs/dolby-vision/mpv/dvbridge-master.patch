+    const AVBufferRef *buf = NULL;
+    for (int n = 0; n < mpi->num_ff_side_data; n++) {
+        if (mpi->ff_side_data[n].type == AV_FRAME_DATA_DOVI_METADATA)
+            buf = mpi->ff_side_data[n].buf;
+    }
+
+    // L5 offsets count decoded pixels, and the packets describe the raster.
+    pl_rect2df dst = target->crop;
+    pl_rect2df_normalize(&dst);
+    const AVDOVIMetadata *m = buf ? (const AVDOVIMetadata *)buf->data : NULL;
+    bool ok = m && dvbridge_dv_bounds(m, buf->size) &&
+              dvbridge_dv_geometry(&p->dv, mpi->w, mpi->h,
+                                   lroundf(dst.x0), lroundf(dst.y0),
+                                   lroundf(pl_rect_w(dst)), lroundf(pl_rect_h(dst))) &&
+              dvbridge_dv_metadata(&p->dv, m, mpi->pts);
+
