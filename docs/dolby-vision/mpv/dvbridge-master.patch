+// Dolby Vision tunnel on amdgpu with the LibreELEC Hades DVBRIDGE patches.
+// The kernel refuses the tunnel unless the primary plane is alone on the CRTC
+// and every colour stage is in bypass, so all of them go back to default.
+static int dvbridge_enum_value(struct drm_object *object, const char *name,
+                               const char *value_name, uint64_t *value)
+{
+    for (int i = 0; i < object->props->count_props; i++) {
+        drmModePropertyRes *info = object->props_info[i];
+        if (strcmp(info->name, name))
+            continue;
+        for (int j = 0; j < info->count_enums; j++) {
+            if (strcmp(info->enums[j].name, value_name))
+                continue;
+            *value = drm_property_type_is(info, DRM_MODE_PROP_BITMASK) ?
+                     1ULL << info->enums[j].value : info->enums[j].value;
+            return 0;
+        }
+    }
+    return -EINVAL;
+}
+
+static void dvbridge_set_enum(struct vo_drm_state *drm, drmModeAtomicReq *request,
+                              struct drm_object *object, char *name,
+                              const char *value_name)
+{
+    uint64_t value;
+    if (dvbridge_enum_value(object, name, value_name, &value) ||
+        drm_object_set_property(request, object, name, value) < 0)
+        MP_VERBOSE(drm, "dvbridge: could not set %s to %s\n", name, value_name);
+}
+
+// Gamescope leaves AMD's private colour properties set after it loses master.
+static void dvbridge_amd_defaults(struct vo_drm_state *drm, drmModeAtomicReq *request,
+                                  struct drm_object *object)
+{
+    for (int i = 0; i < object->props->count_props; i++) {
+        drmModePropertyRes *info = object->props_info[i];
+        if (strncmp(info->name, "AMD_", 4) || (info->flags & DRM_MODE_PROP_IMMUTABLE))
+            continue;
+        uint64_t value;
+        if (drm_property_type_is(info, DRM_MODE_PROP_BLOB)) {
+            value = 0;
+        } else if (drm_property_type_is(info, DRM_MODE_PROP_ENUM)) {
+            if (dvbridge_enum_value(object, info->name, "Default", &value))
+                continue;
+        } else if (!strcmp(info->name, "AMD_PLANE_HDR_MULT")) {
+            value = 1ULL << 32;
+        } else {
+            continue;
+        }
+        if (object->props->prop_values[i] == value)
+            continue;
+        MP_VERBOSE(drm, "dvbridge: %s %llu -> %llu\n", info->name,
+                   (unsigned long long)object->props->prop_values[i],
+                   (unsigned long long)value);
+        drmModeAtomicAddProperty(request, object->id, info->prop_id, value);
+    }
+}
+
+static bool dvbridge_add_tunnel(struct vo_drm_state *drm, drmModeAtomicReq *request)
+{
+    struct drm_atomic_context *atomic_ctx = drm->atomic_context;
+    if (drm_object_set_property(request, atomic_ctx->connector,
+                                "DVBRIDGE_DV_STANDARD_LAB", 1) < 0) {
+        MP_ERR(drm, "The connector has no DVBRIDGE_DV_STANDARD_LAB property. "
+               "Is the patched amdgpu module loaded?\n");
+        return false;
+    }
+    drm_object_set_property(request, atomic_ctx->connector, "max bpc", 8);
+    drm_object_set_property(request, atomic_ctx->connector, "Colorspace",
+                            DRM_MODE_COLORIMETRY_DEFAULT);
+    drm_object_set_property(request, atomic_ctx->connector, "HDR_OUTPUT_METADATA", 0);
+    drm_object_set_property(request, atomic_ctx->crtc, "CTM", 0);
+    drm_object_set_property(request, atomic_ctx->crtc, "GAMMA_LUT", 0);
+    drm_object_set_property(request, atomic_ctx->crtc, "DEGAMMA_LUT", 0);
+    drm_object_set_property(request, atomic_ctx->crtc, "VRR_ENABLED", 0);
+    dvbridge_set_enum(drm, request, atomic_ctx->draw_plane, "rotation", "rotate-0");
+    drm_object_set_property(request, atomic_ctx->draw_plane, "alpha", 0xffff);
+    dvbridge_set_enum(drm, request, atomic_ctx->draw_plane, "pixel blend mode", "None");
+    drm_object_set_property(request, atomic_ctx->draw_plane, "COLOR_PIPELINE", 0);
+    dvbridge_amd_defaults(drm, request, atomic_ctx->crtc);
+    dvbridge_amd_defaults(drm, request, atomic_ctx->draw_plane);
+
+    // Every other plane on this CRTC (cursor, overlays) has to be off.
+    drmModePlaneRes *res = drmModeGetPlaneResources(drm->fd);
+    for (uint32_t i = 0; res && i < res->count_planes; i++) {
+        if (res->planes[i] == atomic_ctx->draw_plane->id)
+            continue;
+        drmModePlane *plane = drmModeGetPlane(drm->fd, res->planes[i]);
+        if (plane && plane->crtc_id == drm->crtc_id) {
+            struct drm_object *object = drm_object_create(drm->log, drm->fd,
+                                                          plane->plane_id,
+                                                          DRM_MODE_OBJECT_PLANE);
+            if (object) {
+                MP_VERBOSE(drm, "dvbridge: turning off plane %u\n", plane->plane_id);
+                drm_object_set_property(request, object, "FB_ID", 0);
+                drm_object_set_property(request, object, "CRTC_ID", 0);
+                drm_object_free(object);
+            }
+        }
+        drmModeFreePlane(plane);
+    }
+    drmModeFreePlaneResources(res);
+    return true;
+}
