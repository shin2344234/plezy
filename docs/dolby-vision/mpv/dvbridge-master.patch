diff --git a/video/out/dvbridge.h b/video/out/dvbridge.h
new file mode 100644
index 0000000..bb51175
--- /dev/null
+++ b/video/out/dvbridge.h
@@ -0,0 +1,304 @@
+/*
+ * Dolby Vision tunnel metadata for the amdgpu DVBRIDGE_DV_STANDARD_LAB output.
+ *
+ * Ported from the dvbridge serializer in LibreELEC Hades
+ * (projects/Generic/patches/kodi/kodi-9990-native-dv.patch,
+ * tools/dvbridge/dvbridge_metadata.h), GPL-3.0-or-later.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * Differences from Hades: the CM v4.0 levels (3, 4, 8-11, 254) need the raw
+ * RPU bytes from a patched FFmpeg, so they are left out and counted instead.
+ * The geometry check accepts any destination rectangle mpv picks.
+ */
+
+#ifndef MP_DVBRIDGE_H
+#define MP_DVBRIDGE_H
+
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <libavutil/dovi_meta.h>
+
+#define DVBRIDGE_W 3840
+#define DVBRIDGE_H 2160
+
+struct dvbridge_dv {
+    uint8_t payload[512], previous[512];
+    unsigned size, previous_size, id;
+    // One byte per element, four elements per uvec4 of the shader's
+    // metadata_words array.
+    uint32_t packets[512];
+    unsigned count;
+    uint64_t frames, changes;
+    double last_pts;
+    int source_w, source_h, dest_x, dest_y, dest_w, dest_h;
+    // Margins of the active picture in the 3840x2160 raster: left, right,
+    // top, bottom.
+    unsigned margins[4];
+    unsigned cm4_omitted;
+};
+
+#define DV_REQUIRE(x) do { if (!(x)) return false; } while (0)
+
+// A profile 7 minimal enhancement layer adds nothing to the base layer, so
+// the frame can be treated as profile 8.1. The test is dovi_tool's is_mel():
+// zero NLQ offset, vdr_in_max of exactly 1.0, and zero deadzone slope and
+// threshold on every component. Only fixed-point coefficients are checked.
+static inline bool dvbridge_dovi_is_mel(const AVDOVIMetadata *m)
+{
+    const AVDOVIRpuDataHeader *h = av_dovi_get_header(m);
+    const AVDOVIDataMapping *map = av_dovi_get_mapping(m);
+    DV_REQUIRE(!h->disable_residual_flag && h->coef_data_type == 0 &&
+               h->coef_log2_denom < 64 && map->nlq_method_idc == AV_DOVI_NLQ_LINEAR_DZ);
+    for (int i = 0; i < 3; i++) {
+        const AVDOVINLQParams *nlq = &map->nlq[i];
+        DV_REQUIRE(nlq->nlq_offset == 0 && nlq->vdr_in_max == 1ULL << h->coef_log2_denom &&
+                   nlq->linear_deadzone_slope == 0 && nlq->linear_deadzone_threshold == 0);
+    }
+    return true;
+}
+
+static inline bool dvbridge_dv_bounds(const AVDOVIMetadata *m, size_t bytes)
+{
+    DV_REQUIRE(m && bytes >= sizeof(*m));
+#define DV_REGION(field, type) \
+    DV_REQUIRE(m->field >= sizeof(*m) && m->field <= bytes && \
+               bytes - m->field >= sizeof(type) && m->field % _Alignof(type) == 0)
+    DV_REGION(header_offset, AVDOVIRpuDataHeader);
+    DV_REGION(color_offset, AVDOVIColorMetadata);
+    DV_REGION(mapping_offset, AVDOVIDataMapping);
+    DV_REGION(ext_block_offset, AVDOVIDmData);
+#undef DV_REGION
+    DV_REQUIRE(m->num_ext_blocks > 0 && m->num_ext_blocks <= AV_DOVI_MAX_EXT_BLOCKS);
+    DV_REQUIRE(m->ext_block_size >= sizeof(AVDOVIDmData) &&
+               m->ext_block_size % _Alignof(AVDOVIDmData) == 0);
+    return (size_t)m->num_ext_blocks <= (bytes - m->ext_block_offset) / m->ext_block_size;
+}
+
+// All scaling and letterboxing happen before packing, so L5 describes the
+// final HDMI raster, not the decoded frame.
+static inline bool dvbridge_dv_geometry(struct dvbridge_dv *d, int w, int h,
+                                        int x, int y, int dw, int dh)
+{
+    DV_REQUIRE(w > 0 && h > 0 && w <= DVBRIDGE_W && h <= DVBRIDGE_H);
+    DV_REQUIRE(dw > 0 && dh > 0 && x >= 0 && y >= 0 &&
+               x + dw <= DVBRIDGE_W && y + dh <= DVBRIDGE_H);
+    d->source_w = w; d->source_h = h;
+    d->dest_x = x; d->dest_y = y; d->dest_w = dw; d->dest_h = dh;
+    return true;
+}
+
+static inline bool dvbridge_dv_area(struct dvbridge_dv *d, unsigned l, unsigned r,
+                                    unsigned t, unsigned b, unsigned v[4])
+{
+    int w = d->source_w ? d->source_w : DVBRIDGE_W;
+    int h = d->source_h ? d->source_h : DVBRIDGE_H;
+    int dw = d->dest_w ? d->dest_w : DVBRIDGE_W;
+    int dh = d->dest_h ? d->dest_h : DVBRIDGE_H;
+    DV_REQUIRE(l < (unsigned)w && r < (unsigned)w - l && t < (unsigned)h && b < (unsigned)h - t);
+    v[0] = d->dest_x + lround((double)l * dw / w);
+    v[1] = DVBRIDGE_W - d->dest_x - dw + lround((double)r * dw / w);
+    v[2] = d->dest_y + lround((double)t * dh / h);
+    v[3] = DVBRIDGE_H - d->dest_y - dh + lround((double)b * dh / h);
+    return v[0] + v[1] < DVBRIDGE_W && v[2] + v[3] < DVBRIDGE_H;
+}
+
+static inline void dvbridge_dv_u16(struct dvbridge_dv *d, unsigned v)
+{
+    d->payload[d->size++] = v >> 8;
+    d->payload[d->size++] = v;
+}
+
+static inline void dvbridge_dv_u32(struct dvbridge_dv *d, unsigned v)
+{
+    dvbridge_dv_u16(d, v >> 16);
+    dvbridge_dv_u16(d, v & 65535);
+}
+
+// CRC-32/MPEG-2: MSB first, no reflection, no final XOR.
+static inline uint32_t dvbridge_dv_crc(const uint8_t *p, size_t n)
+{
+    uint32_t c = 0xffffffff;
+    for (size_t j = 0; j < n; j++) {
+        c ^= (uint32_t)p[j] << 24;
+        for (int i = 0; i < 8; i++)
+            c = (c << 1) ^ ((c >> 31) ? 0x04c11db7u : 0);
+    }
+    return c;
+}
+
+// Builds the packets for the frame being drawn. Takes the RPU of that exact
+// frame, not the decoder's newest one. A repeated PTS (pause, redraw) keeps
+// the payload stable, and a jump in PTS forces a scene refresh so no stale
+// metadata survives a seek. On failure the previous packets stay in place.
+static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetadata *m,
+                                        double pts)
+{
+    DV_REQUIRE(m && isfinite(pts));
+    const AVDOVIColorMetadata *c = av_dovi_get_color(m);
+    const AVDOVIRpuDataHeader *h = av_dovi_get_header(m);
+    // Every profile, profile 7 FEL included: the renderer has composed the
+    // enhancement layer before the pack, and the packets carry only display
+    // management metadata.
+    DV_REQUIRE(c && h);
+    DV_REQUIRE(c->signal_eotf == 65535 && (c->signal_color_space == 0 || c->signal_color_space == 2));
+    DV_REQUIRE(!c->signal_eotf_param0 && !c->signal_eotf_param1 && !c->signal_eotf_param2);
+    DV_REQUIRE(c->source_min_pq <= c->source_max_pq && c->source_max_pq <= 4095);
+    DV_REQUIRE(m->num_ext_blocks > 0 && m->num_ext_blocks <= AV_DOVI_MAX_EXT_BLOCKS);
+
+    struct dvbridge_dv n = *d;
+    bool repeat = d->frames && pts == d->last_pts;
+    bool refresh = !d->frames || pts < d->last_pts || pts - d->last_pts > 0.1;
+    n.size = 0;
+    n.payload[n.size++] = 0;
+    n.payload[n.size++] = repeat ? d->previous[1] : refresh ? 1 : c->scene_refresh_flag;
+    static const int matrix[] = {9574, 0, 13802, 9574, -1540, -5348, 9574, 17610, 0};
+    static const unsigned lms[] = {7222, 8771, 390, 2654, 12430, 1300, 0, 422, 15962};
+    for (int i = 0; i < 9; i++)
+        dvbridge_dv_u16(&n, (uint16_t)matrix[i]);
+    dvbridge_dv_u32(&n, 16777216);
+    dvbridge_dv_u32(&n, 134217728);
+    dvbridge_dv_u32(&n, 134217728);
+    for (int i = 0; i < 9; i++)
+        dvbridge_dv_u16(&n, lms[i]);
+    dvbridge_dv_u16(&n, 65535);
+    dvbridge_dv_u32(&n, 0);
+    dvbridge_dv_u32(&n, 0);
+    n.payload[n.size++] = 12;
+    n.payload[n.size++] = 0;
+    n.payload[n.size++] = 1;
+    n.payload[n.size++] = 1;
+    dvbridge_dv_u16(&n, c->source_min_pq);
+    dvbridge_dv_u16(&n, c->source_max_pq);
+    dvbridge_dv_u16(&n, 42);
+    unsigned count_pos = n.size++;
+    n.payload[count_pos] = 0;
+
+    // Levels in ascending order, as Hades sends them.
+    const AVDOVIDmData *ordered[AV_DOVI_MAX_EXT_BLOCKS];
+    unsigned order[AV_DOVI_MAX_EXT_BLOCKS];
+    for (int i = 0; i < m->num_ext_blocks; i++) {
+        const AVDOVIDmData *e = av_dovi_get_ext(m, i);
+        int j = i;
+        while (j > 0 && order[j - 1] > e->level) {
+            ordered[j] = ordered[j - 1];
+            order[j] = order[j - 1];
+            j--;
+        }
+        ordered[j] = e;
+        order[j] = e->level;
+    }
+
+    unsigned l1 = 0, area = 0, targets[AV_DOVI_MAX_EXT_BLOCKS], ntargets = 0;
+    n.cm4_omitted = 0;
+    unsigned margins[4];
+    bool have_margins = false;
+    for (int i = 0; i < m->num_ext_blocks; i++) {
+        const AVDOVIDmData *e = ordered[i];
+        unsigned v[7] = {0}, k = 0;
+        DV_REQUIRE(n.size + 20 < sizeof(n.payload));
+        switch (e->level) {
+        case 1:
+            DV_REQUIRE(!area);
+            l1++;
+            k = 3;
+            v[0] = e->l1.min_pq; v[1] = e->l1.max_pq; v[2] = e->l1.avg_pq;
+            DV_REQUIRE(v[0] <= v[2] && v[2] <= v[1]);
+            break;
+        case 2:
+            DV_REQUIRE(!area);
+            k = 7;
+            v[0] = e->l2.target_max_pq; v[1] = e->l2.trim_slope; v[2] = e->l2.trim_offset;
+            v[3] = e->l2.trim_power; v[4] = e->l2.trim_chroma_weight;
+            v[5] = e->l2.trim_saturation_gain; v[6] = (uint16_t)e->l2.ms_weight;
+            for (unsigned j = 0; j < ntargets; j++)
+                DV_REQUIRE(targets[j] != v[0]);
+            targets[ntargets++] = v[0];
+            break;
+        case 5:
+            area++;
+            DV_REQUIRE(l1 == 1 && area == 1);
+            k = 4;
+            DV_REQUIRE(dvbridge_dv_area(&n, e->l5.left_offset, e->l5.right_offset,
+                                        e->l5.top_offset, e->l5.bottom_offset, v));
+            memcpy(margins, v, sizeof(margins));
+            have_margins = true;
+            break;
+        case 3: case 4: case 8: case 9: case 10: case 11: case 254:
+            n.cm4_omitted++;
+            continue;
+        case 6:
+            continue; // static HDR10 fallback, not dynamic DV data
+        default:
+            return false;
+        }
+        for (unsigned j = 0; j < k; j++)
+            DV_REQUIRE(v[j] <= 4095 || (e->level == 2 && j == 6 && v[j] == 65535));
+        dvbridge_dv_u32(&n, k * 2);
+        n.payload[n.size++] = e->level;
+        for (unsigned j = 0; j < k; j++)
+            dvbridge_dv_u16(&n, v[j]);
+        n.payload[count_pos]++;
+    }
+    DV_REQUIRE(l1 == 1);
+    if (!area) {
+        unsigned v[4];
+        DV_REQUIRE(dvbridge_dv_area(&n, 0, 0, 0, 0, v));
+        DV_REQUIRE(n.size + 13 < sizeof(n.payload));
+        dvbridge_dv_u32(&n, 8);
+        n.payload[n.size++] = 5;
+        for (int j = 0; j < 4; j++)
+            dvbridge_dv_u16(&n, v[j]);
+        n.payload[count_pos]++;
+        memcpy(margins, v, sizeof(margins));
+        have_margins = true;
+    }
+    DV_REQUIRE(have_margins && n.size <= 482 && n.payload[count_pos] <= AV_DOVI_MAX_EXT_BLOCKS);
+
+    if (d->frames && (d->previous_size != n.size || memcmp(d->previous, n.payload, n.size))) {
+        n.id = (n.id + 1) & 15;
+        n.changes++;
+    }
+    memcpy(n.previous, n.payload, n.size);
+    n.previous_size = n.size;
+    n.count = n.size <= 119 ? 1 : 1 + (n.size - 119 + 120) / 121;
+    DV_REQUIRE(n.count <= 4);
+    memset(n.packets, 0, sizeof(n.packets));
+    unsigned off = 0;
+    for (unsigned i = 0; i < n.count; i++) {
+        uint8_t p[128] = {0};
+        p[0] = (n.count == 1 ? 0 : i == 0 ? 1 : i + 1 == n.count ? 3 : 2) << 6;
+        p[1] = (n.id << 4) | n.id;
+        unsigned start = i ? 3 : 5, room = i ? 121 : 119;
+        unsigned take = n.size - off;
+        if (take > room)
+            take = room;
+        if (!i) {
+            p[3] = n.size >> 8;
+            p[4] = n.size;
+        }
+        memcpy(p + start, n.payload + off, take);
+        off += take;
+        uint32_t crc = dvbridge_dv_crc(p, 124);
+        for (int j = 0; j < 4; j++)
+            p[124 + j] = crc >> (24 - j * 8);
+        DV_REQUIRE(!dvbridge_dv_crc(p, 128));
+        for (unsigned j = 0; j < 128; j++)
+            n.packets[i * 128 + j] = p[j];
+    }
+    memcpy(n.margins, margins, sizeof(margins));
+    n.last_pts = pts;
+    n.frames++;
+    *d = n;
+    return true;
+}
+
+#undef DV_REQUIRE
+
+#endif
