+// Packs the PQ RGB intermediate into the tunnel: 12-bit limited-range BT.2020
+// Y'CbCr 4:2:2 in 8-bit RGB, with the metadata packets in the chroma LSBs.
+// Each packet covers 3072 pixels, its 1024 bits sent three times over.
+static bool dv_pack(struct vo *vo, const struct pl_swapchain_frame *swframe)
+{
+    struct priv *p = vo->priv;
+    unsigned count = p->dv.count;
+    unsigned flip = swframe->flipped;
+
+    pl_shader sh = pl_dispatch_begin(p->dv_dp);
+    bool ok = pl_shader_custom(sh, &(struct pl_custom_shader) {
+        .description = "dolby vision tunnel",
+        .output = PL_SHADER_SIG_COLOR,
+        .header =
+            "uint dv_parity(uint v)            \n"
+            "{                                 \n"
+            "    v ^= v >> 16u;                \n"
+            "    v ^= v >> 8u;                 \n"
+            "    v ^= v >> 4u;                 \n"
+            "    v ^= v >> 2u;                 \n"
+            "    v ^= v >> 1u;                 \n"
+            "    return v & 1u;                \n"
+            "}                                 \n",
+        .body =
+            "ivec2 p = ivec2(gl_FragCoord.xy);\n"
+            "if (flip_y != 0u)\n"
+            "    p.y = 2159 - p.y;\n"
+            "ivec2 q = ivec2(p.x & ~1, p.y);\n"
+            "vec3 a = clamp(texelFetch(pq_input, q, 0).rgb, 0.0, 1.0);\n"
+            "vec3 b = clamp(texelFetch(pq_input, q + ivec2(1, 0), 0).rgb, 0.0, 1.0);\n"
+            "float ya = dot(a, vec3(0.2627, 0.6780, 0.0593));\n"
+            "float yb = dot(b, vec3(0.2627, 0.6780, 0.0593));\n"
+            "uint y = uint(floor(256.0 + 3504.0 * ((p.x & 1) == 0 ? ya : yb) + 0.5));\n"
+            "float cb = 2048.0 + 3584.0 * ((a.b - ya) + (b.b - yb)) / (2.0 * 1.8814);\n"
+            "float cr = 2048.0 + 3584.0 * ((a.r - ya) + (b.r - yb)) / (2.0 * 1.4746);\n"
+            "uint c = uint(floor(((p.x & 1) == 0 ? cb : cr) + 0.5));\n"
+            "uint index = uint(p.y * 3840 + p.x);\n"
+            "uint packet = index / 3072u;\n"
+            "if (packet < packet_count) {\n"
+            "    uint bit = index % 1024u;\n"
+            "    uint byte_index = packet * 128u + bit / 8u;\n"
+            "    uint v = (metadata_words[byte_index / 4u][int(byte_index % 4u)]\n"
+            "              >> (7u - bit % 8u)) & 1u;\n"
+            "    c = (c & 4094u) | (v ^ dv_parity(c >> 1u) ^ dv_parity(y));\n"
+            "}\n"
+            "color = vec4(float(c >> 4u), float(y >> 4u),\n"
+            "             float((y & 15u) | ((c & 15u) << 4u)), 255.0) / 255.0;\n",
+        .descriptors = &(struct pl_shader_desc) {
+            .desc = { .name = "pq_input", .type = PL_DESC_SAMPLED_TEX },
+            .binding = {
+                .object = p->dv_tex,
+                .address_mode = PL_TEX_ADDRESS_CLAMP,
+                .sample_mode = PL_TEX_SAMPLE_NEAREST,
+            },
+        },
+        .num_descriptors = 1,
+        .variables = (struct pl_shader_var[]) {
+            {
+                .var = {
+                    .name = "metadata_words",
+                    .type = PL_VAR_UINT,
+                    .dim_v = 4,
+                    .dim_m = 1,
+                    .dim_a = MP_ARRAY_SIZE(p->dv.packets) / 4,
+                },
+                .data = p->dv.packets,
+                .dynamic = true,
+            },
+            { .var = pl_var_uint("packet_count"), .data = &count, .dynamic = true },
+            { .var = pl_var_uint("flip_y"), .data = &flip },
+        },
+        .num_variables = 3,
+    });
+    if (!ok) {
+        pl_dispatch_abort(p->dv_dp, &sh);
+        return false;
+    }
+    return pl_dispatch_finish(p->dv_dp, pl_dispatch_params(
+        .shader = &sh,
+        .target = swframe->fbo,
+    ));
+}
