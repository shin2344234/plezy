+// The pack pass needs the PQ values at full precision, so the frame and the
+// OSD are rendered to a float texture first.
+static bool dv_prepare_target(struct vo *vo, struct pl_frame *target,
+                              const struct pl_swapchain_frame *swframe)
+{
+    struct priv *p = vo->priv;
+    pl_tex fbo = swframe->fbo;
+    if (fbo->params.w != DVBRIDGE_W || fbo->params.h != DVBRIDGE_H) {
+        if (!p->dv_warned_size) {
+            MP_ERR(vo, "The Dolby Vision tunnel needs a %dx%d output, got %dx%d.\n",
+                   DVBRIDGE_W, DVBRIDGE_H, fbo->params.w, fbo->params.h);
+        }
+        p->dv_warned_size = true;
+        return false;
+    }
+
+    pl_fmt fmt = pl_find_named_fmt(p->gpu, "rgba32f");
+    // blit_dst because libplacebo clears the letterbox bars with pl_tex_clear.
+    enum pl_fmt_caps caps = PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE |
+                            PL_FMT_CAP_BLITTABLE;
+    if (!fmt || (fmt->caps & caps) != caps ||
+        !pl_tex_recreate(p->gpu, &p->dv_tex, pl_tex_params(
+            .w = DVBRIDGE_W,
+            .h = DVBRIDGE_H,
+            .format = fmt,
+            .renderable = true,
+            .sampleable = true,
+            .blit_dst = true,
+        )))
+    {
+        MP_ERR(vo, "Could not create the Dolby Vision intermediate texture.\n");
+        return false;
+    }
+
+    target->planes[0].texture = p->dv_tex;
+    target->planes[0].flipped = false;
+    target->repr = pl_color_repr_rgb;
+    target->icc = NULL;
+    target->lut = NULL;
+    return true;
