+// Builds the packets from the RPU of the frame on screen. Without a usable
+// RPU the previous packets stay, so one bad frame doesn't drop the TV out of
+// Dolby Vision.
+static void dv_update(struct vo *vo, const struct pl_frame_mix *mix,
+                      struct pl_frame *target)
+{
+    struct priv *p = vo->priv;
+    const struct pl_frame *cur = mix->num_frames ? pl_frame_mix_nearest(mix) : NULL;
+
+    // The pack pass expects PQ BT.2020. With the target in the frame's own
+    // mapped colour space, libplacebo doesn't tone map at all.
+    target->color = pl_color_space_hdr10;
+    if (cur && cur->color.primaries == PL_COLOR_PRIM_BT_2020 &&
+        cur->color.transfer == PL_COLOR_TRC_PQ)
+        target->color = cur->color;
+    if (!cur)
+        return;
+
+    struct mp_image *mpi = cur->user_data;
+
+    // A FEL frame whose EL never arrived is composed from the BL alone. The
+    // tunnel stays up, since leaving it would switch the TV's mode.
+    const struct pl_dovi_metadata *dovi = cur->repr.dovi;
+    if (dovi && dovi->nlq_active && mpi->pts != p->dv_last_pts) {
+        p->dv_last_pts = mpi->pts;
+        p->dv_fel_frames++;
+        if (!cur->enhancement_layer) {
+            p->dv_fel_bl_only++;
+            if (!p->dv_warned_el) {
+                MP_WARN(vo, "Dolby Vision FEL frame at %f has no enhancement "
+                        "layer, showing the base layer alone.\n", mpi->pts);
+                p->dv_warned_el = true;
+            }
+        }
+    }
